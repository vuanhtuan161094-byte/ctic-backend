# CMP production environment contract. Copy to .env on the deployed backend host.
# Never commit real credentials/secrets.
NODE_ENV=production
APP_VERSION=1.0.0
APP_BUILD_ID=
APP_RELEASE_CHANNEL=production

HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_BASE_URL=https://cert.example.com
CORS_ORIGINS=https://cert.example.com
CORS_ALLOW_PRIVATE_NETWORK=false
TRUST_PROXY=1
SWAGGER_ENABLED=false

DATABASE_URL=sqlserver://sql.example.internal:1433;database=CMP;user=CMP_RUNTIME;password={CHANGE_ME};encrypt=true;trustServerCertificate=false
JWT_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_SECONDS=3600

PUBLIC_REGISTRATION_ENABLED=false
SECURITY_HEADERS_ENABLED=true
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=50
PUBLIC_CERT_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CERT_RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_MAX_ENTRIES=10000

# Must be an absolute persistent path outside the application deployment directory.
STORAGE_ROOT=E:\CMP-DATA\storage

DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=120000
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_PACKET_SIZE=4096
DB_STARTUP_MAX_ATTEMPTS=5
DB_STARTUP_RETRY_DELAY_MS=2500
DB_STARTUP_MAX_RETRY_DELAY_MS=10000
DB_RECONNECT_MAX_ATTEMPTS=4
DB_RECONNECT_RETRY_DELAY_MS=2000
DB_PREFLIGHT_MAX_ATTEMPTS=10
DB_PREFLIGHT_STABLE_SUCCESSES=3
DB_PREFLIGHT_RETRY_DELAY_MS=2500
DB_PREFLIGHT_TCP_TIMEOUT_MS=2500

# Do not put MIGRATION_DATABASE_URL, TEST_DATABASE_URL or P09_* variables in the runtime production process.
