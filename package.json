{
  "name": "ctic-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node scripts/copy-report-assets.cjs && node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:p09": "node scripts/tests/run-p09-real-e2e.cjs",
    "test:e2e:application-review-capability": "node scripts/tests/run-application-review-capability-e2e.cjs",
    "test:smoke": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/p09-smoke-test.ps1",
    "test:regression": "node scripts/tests/run-current-regressions-patch36c0.mjs",
    "prisma:validate": "prisma validate",
    "db:seed": "prisma db seed",
    "db:migrate:deploy": "npm run db:migrate:retry && prisma generate && node scripts/verify-prisma-client-patch35a4.cjs && npm run db:contract",
    "postbuild": "node scripts/copy-report-assets.cjs",
    "prisma:generate": "prisma generate && node scripts/verify-prisma-client-patch35a4.cjs",
    "prebuild": "node scripts/runtime-compatibility-check-patch36c0.cjs && prisma generate && node scripts/verify-prisma-client-patch35a4.cjs",
    "prestart:dev": "node scripts/runtime-compatibility-check-patch36c0.cjs && prisma generate && node scripts/verify-prisma-client-patch35a4.cjs && npm run db:preflight",
    "prisma:verify": "node scripts/verify-prisma-client-patch35a4.cjs",
    "runtime:check": "node scripts/runtime-compatibility-check-patch36c0.cjs",
    "runtime:check:strict": "node scripts/runtime-compatibility-check-patch36c0.cjs --strict",
    "db:doctor": "node scripts/database-schema-contract-patch36c1.cjs",
    "db:repair": "node scripts/repair-critical-schema-patch36c0.cjs",
    "db:stabilize": "node scripts/database-stabilize-patch36c1a.cjs",
    "env:lan": "node scripts/configure-lan-patch36c0.cjs",
    "stabilize": "npm run stabilize:commercial",
    "prestart:prod": "npm run prod:env:check && node scripts/runtime-compatibility-check-patch36c0.cjs --strict && prisma generate && node scripts/verify-prisma-client-patch35a4.cjs && npm run db:preflight && npm run db:contract && npm run db:runtime-permissions -- --strict",
    "db:preflight": "node scripts/database-preflight-patch36c0a.cjs",
    "db:recover:local": "node scripts/database-preflight-patch36c0a.cjs --auto-start-local-sql",
    "db:adopt-existing": "node scripts/adopt-existing-database-patch36c1a.cjs",
    "db:migrate:retry": "node scripts/migrate-with-retry-patch36c1a.cjs",
    "db:contract": "node scripts/database-schema-contract-patch36c1.cjs",
    "stabilize:commercial": "node scripts/commercial-stabilize-patch36c1a.cjs",
    "db:migration-permissions": "node scripts/migration-credentials-preflight-patch36c1a.cjs",
    "db:runtime-permissions": "node scripts/runtime-database-permissions-patch36c1a.cjs",
    "verify": "npm run runtime:check && npm run prisma:validate && npm run prisma:generate && npm run build && npm test -- --runInBand && npm run test:regression && npm run db:preflight && npm run db:contract",
    "test:e2e:surveillance-information": "node scripts/tests/run-surveillance-information-snapshot-e2e.cjs",
    "test:e2e:certificate-lifecycle": "node scripts/tests/run-p09-real-e2e.cjs",
    "prod:env:check": "node scripts/production/validate-production-env.cjs",
    "prod:http-smoke": "node scripts/production/http-security-smoke.cjs",
    "prod:performance:smoke": "node scripts/production/performance-smoke.cjs",
    "release:manifest": "node scripts/production/create-release-manifest.cjs",
    "security:audit:prod": "npm audit --omit=dev --audit-level=high",
    "uat:master": "node scripts/uat/run-master-uat.cjs",
    "uat:master:no-p09": "node scripts/uat/run-master-uat.cjs --skip-p09"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/adapter-mssql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "prisma": "^7.8.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  }
}
