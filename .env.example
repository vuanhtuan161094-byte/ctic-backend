# Không commit file .env thật. Điền thông tin môi trường triển khai vào .env cục bộ.

# =========================
# DATABASE / SECURITY
# =========================
DATABASE_URL=sqlserver://localhost:1433;database=CMP;user=YOUR_USER;password=YOUR_PASSWORD;trustServerCertificate=true

# Connection pool / timeout. Adapter MSSQL dùng các giá trị này cho long-running backend.
DB_CONNECTION_TIMEOUT_MS=15000
DB_REQUEST_TIMEOUT_MS=120000
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_PACKET_SIZE=4096

# Startup resilience: chờ SQL Server sau reboot/service restart trước khi fail-fast.
DB_STARTUP_MAX_ATTEMPTS=5
DB_STARTUP_RETRY_DELAY_MS=2500
DB_STARTUP_MAX_RETRY_DELAY_MS=10000

# Runtime reconnect khi connection pool bị Final/Closed/timeout/reset.
DB_RECONNECT_MAX_ATTEMPTS=4
DB_RECONNECT_RETRY_DELAY_MS=2000

# Standalone database preflight trước migrate/start.
DB_PREFLIGHT_MAX_ATTEMPTS=10
# Yêu cầu nhiều query liên tiếp thành công trước migrate để tránh SQL vừa mở TCP nhưng chưa sẵn sàng.
DB_PREFLIGHT_STABLE_SUCCESSES=3
DB_PREFLIGHT_RETRY_DELAY_MS=2500
DB_PREFLIGHT_TCP_TIMEOUT_MS=2500

# Retry Prisma migrate deploy chỉ với lỗi kết nối tạm thời.
DB_MIGRATION_MAX_ATTEMPTS=6
DB_MIGRATION_RETRY_DELAY_MS=2500
DB_MIGRATION_MAX_RETRY_DELAY_MS=15000

JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
# Access token mặc định 8 giờ để giữ tương thích. Production có thể giảm còn 3600-7200 giây.
JWT_ACCESS_TTL_SECONDS=28800

# =========================
# API SECURITY / RATE LIMIT
# =========================
# Tắt mặc định vì tài khoản nội bộ phải tạo trong menu Quản trị người dùng.
PUBLIC_REGISTRATION_ENABLED=false

# Chống brute-force đăng nhập. Có 2 bucket: IP+username và toàn IP.
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_MAX_ATTEMPTS_PER_IP=50

# Giới hạn endpoint tra cứu/QR/PDF chứng chỉ công khai.
PUBLIC_CERT_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_CERT_RATE_LIMIT_MAX_REQUESTS=120

# Giới hạn số bucket rate-limit giữ trong RAM của một Node process.
RATE_LIMIT_MAX_ENTRIES=10000
SECURITY_HEADERS_ENABLED=true

# =========================
# DEPLOYMENT / NETWORK
# =========================
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# URL BACKEND mà người dùng/QR có thể truy cập thật sự.
# DEV:    http://localhost:3000
# LAN:    http://192.168.1.50:3000
# DOMAIN: https://api.example.com
# BẮT BUỘC khi NODE_ENV=production. Không dùng localhost trong production.
PUBLIC_BASE_URL=http://localhost:3000

# URL frontend nếu frontend chạy khác origin với backend.
# Ví dụ: https://cert.example.com hoặc http://192.168.1.50:5173
FRONTEND_BASE_URL=http://localhost:5173

# Có thể khai báo nhiều origin, cách nhau bằng dấu phẩy.
# Không dùng * vì backend bật credentials=true.
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# Development mặc định cho phép localhost/IP private để test LAN.
# Production mặc định false; chỉ bật nếu chủ động triển khai nội bộ LAN.
CORS_ALLOW_PRIVATE_NETWORK=true

# Khi backend đứng sau Nginx/Cloudflare/reverse proxy:
# false = không tin proxy; true = tin toàn bộ; 1 = tin 1 hop proxy.
TRUST_PROXY=false

# Production mặc định tắt Swagger nếu không khai báo true.
SWAGGER_ENABLED=true

# =========================
# BRANDING
# =========================
CERTIFICATION_BODY_SHORT_NAME=CB
CERTIFICATION_BODY_NAME=TỔ CHỨC CHỨNG NHẬN / CERTIFICATION BODY
CERTIFICATION_BODY_WEBSITE=
CERTIFICATION_BODY_EMAIL=
CERTIFICATION_BODY_PHONE=
CERTIFICATION_BODY_ADDRESS=
CERTIFICATION_BODY_SIGNER_NAME=
CERTIFICATION_BODY_SIGNER_TITLE_VI=ĐẠI DIỆN TỔ CHỨC CHỨNG NHẬN
CERTIFICATION_BODY_SIGNER_TITLE_EN=FOR CERTIFICATION BODY
PLATFORM_TITLE=Certification Management Platform
SWAGGER_SITE_TITLE=CB CMP API

# =========================
# STORAGE / HỒ SƠ ĐIỆN TỬ
# =========================
# Gốc kho lưu trữ hồ sơ. Có thể dùng đường dẫn tương đối khi DEV.
# DEV mặc định tương thích bản cũ: ./uploads
# Production nên dùng đường dẫn tuyệt đối trên ổ dữ liệu riêng, ví dụ:
# STORAGE_ROOT=E:\\CMP-DATA\\storage
# hoặc Linux/Docker: /var/lib/cmp/storage
# Khi đổi STORAGE_ROOT, hãy di chuyển thư mục documents hiện có sang <STORAGE_ROOT>/documents trước khi chạy production.
STORAGE_ROOT=./uploads

# =========================
# RUNTIME BASELINE
# =========================
# Backend Prisma 7: chốt Node.js 24 LTS cho production; Node.js 22 LTS cũng được hỗ trợ.
# Không dùng Node.js Current chưa nằm trong dải Prisma hỗ trợ chính thức cho production.

# =========================
# DATABASE DEPLOYMENT MODEL
# =========================
# Mỗi bản cài đặt chỉ phục vụ MỘT tổ chức chứng nhận.
# DATABASE_URL là tài khoản backend runtime: chỉ quyền đọc/ghi nghiệp vụ, KHÔNG cấp DDL/db_owner trong production.
# Tài khoản schema migration đặt riêng trong file .env.migration (xem .env.migration.example).
# Không đặt MIGRATION_DATABASE_URL vào frontend hoặc source code.
