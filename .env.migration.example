# ==========================================================
# DATABASE MIGRATION CREDENTIAL - KHÔNG DÙNG CHO BACKEND RUNTIME
# ==========================================================
# 1 installation = 1 certification body.
# File thật nên đặt tên .env.migration và KHÔNG commit Git.
# Tài khoản migration chỉ dùng khi cài đặt/nâng cấp database.
# Khuyến nghị SQL Server roles trong database:
#   db_ddladmin + db_datareader + db_datawriter
# Không cần cho tài khoản backend runtime quyền CREATE/ALTER/DROP.
#
# Ví dụ:
# MIGRATION_DATABASE_URL=sqlserver://localhost:1433;database=CTIC_Certification;user=CMP_MIGRATOR;password={CHANGE_ME};schema=dbo;trustServerCertificate=true

MIGRATION_DATABASE_URL=
