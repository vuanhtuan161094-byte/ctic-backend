  status                       String?                                 @default("active", map: "DF__customers__statu__6FE99F9F") @db.NVarChar(20)
  created_at                   DateTime                                @default(now(), map: "DF__customers__creat__71D1E811")
  updated_at                   DateTime                                @default(now(), map: "DF__customers__updat__72C60C4A") @updatedAt
  contacts                     contacts[]
