generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model audit_logs {
  id          String   @id(map: "PK__audit_lo__3213E83F7D61AA61") @default(dbgenerated("newid()"), map: "DF__audit_logs__id__59063A47") @db.UniqueIdentifier
  user_id     String?  @db.UniqueIdentifier
  action      String   @db.NVarChar(100)
  entity_type String?  @db.NVarChar(50)
  entity_id   String?  @db.UniqueIdentifier
  ip_address  String?  @db.NVarChar(50)
  user_agent  String?  @db.NVarChar(255)
  request_id  String?  @db.NVarChar(100)
  outcome     String?  @db.NVarChar(20)
  status_code Int?
  duration_ms Int?
  details_json String?  @db.NVarChar(Max)
  created_at  DateTime @default(now(), map: "DF__audit_log__creat__5AEE82B9")
  users       users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK__audit_log__user___59FA5E80")

  @@index([created_at], map: "IX_audit_logs_created")
  @@index([user_id], map: "IX_audit_logs_user")
  @@index([request_id], map: "IX_audit_logs_request_id")
  @@index([outcome, created_at], map: "IX_audit_logs_outcome_created")
}

model audit_plans {
  id             String  @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  project_id     String  @db.UniqueIdentifier
  audit_event_id String? @db.UniqueIdentifier

  plan_code  String? @unique @db.NVarChar(50)
  version_no Int     @default(1)

  audit_type String? @db.NVarChar(30)

  planned_start_date DateTime? @map("plan_date") @db.Date
  planned_end_date   DateTime? @db.Date

  location         String? @db.NVarChar(Max)
  audit_scope      String? @db.NVarChar(Max)
  audit_criteria   String? @db.NVarChar(Max)
  audit_objectives String? @db.NVarChar(Max)

  status     String?  @default("draft") @db.NVarChar(30)
  form_data  String?  @db.NVarChar(Max)
  created_at DateTime @default(now())
  updated_at DateTime @default(now()) @updatedAt

  certification_projects certification_projects @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  audit_event            audit_program_events?  @relation(fields: [audit_event_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  reports                   reports[]
  audit_team_appointment    audit_team_appointments?
  work_items                work_items[]
  expert_monitoring_records expert_monitoring_records[]
  special_audit_case        special_audit_cases?

  @@index([project_id])
  @@index([audit_event_id])
  @@index([audit_type])
  @@index([status])
  @@index([planned_start_date])
}

model certificates {
  id                        String                   @id(map: "PK__certific__3213E83F937E4BBE") @default(dbgenerated("newid()"), map: "DF__certificates__id__1EA48E88") @db.UniqueIdentifier
  verification_code         String                   @unique @default(dbgenerated("newid()")) @db.UniqueIdentifier
  technical_review_id       String                   @unique(map: "UQ__certific__6ED41B569BBE96A3") @db.UniqueIdentifier
  certification_decision_id String?                  @db.UniqueIdentifier
  certificate_series_id     String                   @db.UniqueIdentifier
  supersedes_certificate_id String?                  @db.UniqueIdentifier
  version_no                Int
  cert_number               String                   @db.NVarChar(50)
  issue_date                DateTime?                @db.Date
  expire_date               DateTime?                @db.Date
  status                    String?                  @default("active", map: "DF__certifica__statu__208CD6FA") @db.NVarChar(20)
  change_reason             String?                  @db.NVarChar(Max)
  organization_name         String                   @db.NVarChar(255)
  organization_address      String?                  @db.NVarChar(Max)
  management_system         String?                  @db.NVarChar(100)
  standard_name             String                   @db.NVarChar(100)
  certification_scope       String                   @db.NVarChar(Max)
  site_snapshot_json        String?                  @db.NVarChar(Max)
  created_at                DateTime                 @default(now(), map: "DF__certifica__creat__22751F6C")
  updated_at                DateTime                 @default(now(), map: "DF__certifica__updat__236943A5")
  technical_reviews         technical_reviews        @relation(fields: [technical_review_id], references: [id], onUpdate: NoAction, map: "FK__certifica__techn__1F98B2C1")
  certification_decision    certification_decisions? @relation(fields: [certification_decision_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_certificates_certification_decision")
  certificate_series        certificate_series       @relation(fields: [certificate_series_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_certificates_certificate_series")
  supersedes_certificate    certificates?            @relation("CertificateSupersession", fields: [supersedes_certificate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  superseded_by             certificates[]           @relation("CertificateSupersession")

  status_histories certificate_status_histories[]

  @@unique([certificate_series_id, version_no], map: "UQ_certificates_series_version")
  @@index([certification_decision_id], map: "IX_certificates_decision")
  @@index([cert_number], map: "IX_certificates_cert_number")
  @@index([supersedes_certificate_id], map: "IX_certificates_supersedes")
}

model certificate_series {
  id          String   @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  project_id  String   @db.UniqueIdentifier
  series_code String   @unique @db.NVarChar(50)
  status      String   @default("active") @db.NVarChar(30)
  created_at  DateTime @default(now()) @db.DateTime2
  updated_at  DateTime @default(now()) @updatedAt @db.DateTime2

  certification_project      certification_projects       @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  certificates               certificates[]
  certification_decisions    certification_decisions[]
  certification_change_cases certification_change_cases[]
  special_audit_cases        special_audit_cases[]
  complaint_cases            complaint_cases[]
  appeal_cases               appeal_cases[]

  @@index([project_id], map: "IX_certificate_series_project")
  @@index([project_id, status], map: "IX_certificate_series_project_status")
}

model certificate_status_histories {
  id String @id @default(dbgenerated("newid()")) @db.UniqueIdentifier

  certificate_id            String  @db.UniqueIdentifier
  certification_decision_id String? @db.UniqueIdentifier

  from_status String @db.NVarChar(20)
  to_status   String @db.NVarChar(20)

  reason         String   @db.NVarChar(Max)
  effective_date DateTime @db.Date

  changed_by String? @db.UniqueIdentifier

  created_at DateTime @default(now()) @db.DateTime2

  certificates           certificates             @relation(fields: [certificate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  certification_decision certification_decisions? @relation(fields: [certification_decision_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  changed_by_user users? @relation("CertificateStatusChangedBy", fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([certificate_id, created_at], map: "IX_certificate_status_histories_certificate")
  @@index([certification_decision_id], map: "IX_certificate_status_histories_decision")
}

model certification_projects {
  id                     String   @id(map: "PK__certific__3213E83F23548939") @default(dbgenerated("newid()"), map: "DF__certificatio__id__02084FDA") @db.UniqueIdentifier
  application_id         String   @db.UniqueIdentifier
  contract_id            String?  @db.UniqueIdentifier
  agreement_id           String?  @db.UniqueIdentifier
  project_code           String   @unique(map: "UQ__certific__891B3A6F31225100") @db.NVarChar(50)
  standard_name          String?  @db.NVarChar(100)
  scheme_config_snapshot String?  @db.NVarChar(Max)
  status                 String?  @default("draft") @db.NVarChar(50)
  created_at             DateTime @default(now(), map: "DF__certifica__creat__03F0984C")
  updated_at             DateTime @default(now(), map: "DF__certifica__updat__04E4BC85") @updatedAt

  audit_plans                        audit_plans[]
  manday_calculations                manday_calculations[]
  audit_programs                     audit_programs[]
  industry_scopes                    certification_project_scopes[]
  surveillance_information_snapshots surveillance_information_snapshots[]
  certificate_series                 certificate_series[]
  certification_decisions            certification_decisions[]
  work_items                         work_items[]
  notifications                      notifications[]
  delegations                        delegations[]
  delegated_action_logs              delegated_action_logs[]
  certification_change_cases         certification_change_cases[]
  special_audit_cases                special_audit_cases[]
  complaint_cases                    complaint_cases[]
  appeal_cases                       appeal_cases[]
  quotations                         quotations[]
  billing_milestones                 billing_milestones[]

  certification_applications certification_applications @relation(fields: [application_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts                  contracts?                 @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  certification_agreements   certification_agreements?  @relation(fields: [agreement_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([application_id])
  @@index([contract_id])
  @@index([agreement_id])
}

model contacts {
  id          String    @id(map: "PK__contacts__3213E83F8A1DD906") @default(dbgenerated("newid()"), map: "DF__contacts__id__75A278F5") @db.UniqueIdentifier
  customer_id String    @db.UniqueIdentifier
  full_name   String    @db.NVarChar(100)
  email       String?   @db.NVarChar(255)
  phone       String?   @db.NVarChar(20)
  position    String?   @db.NVarChar(100)
  customers   customers @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "FK__contacts__custom__76969D2E")
}

model contracts {
  id                       String                     @id(map: "PK__contract__3213E83FE3E41EAB") @default(dbgenerated("newid()"), map: "DF__contracts__id__7A672E12") @db.UniqueIdentifier
  customer_id              String                     @db.UniqueIdentifier
  contract_number          String?                    @unique(map: "UQ__contract__1CA37CCEA677F36B") @db.NVarChar(50)
  sign_date                DateTime?                  @db.Date
  start_date               DateTime?                  @db.Date
  end_date                 DateTime?                  @db.Date
  total_value              Decimal?                   @db.Decimal(18, 2)
  currency                 String?                    @db.NVarChar(3)
  quotation_id             String?                    @unique(map: "UQ_contracts_quotation") @db.UniqueIdentifier
  commercial_status        String                     @default("DRAFT") @db.NVarChar(30)
  payment_terms            String?                    @db.NVarChar(1000)
  renewal_date             DateTime?                  @db.Date
  sales_owner_id           String?                    @db.UniqueIdentifier
  commercial_note          String?                    @db.NVarChar(Max)
  created_at               DateTime                   @default(now(), map: "DF__contracts__creat__7C4F7684")
  updated_at               DateTime                   @default(now(), map: "DF__contracts__updat__7D439ABD")
  certification_projects   certification_projects[]
  certification_agreements certification_agreements[]
  customers                customers                  @relation(fields: [customer_id], references: [id], onUpdate: NoAction, map: "FK__contracts__custo__7B5B524B")
  quotation                quotations?                @relation(fields: [quotation_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_contracts_quotation")
  billing_milestones       billing_milestones[]

  @@index([commercial_status, sign_date], map: "IX_contracts_commercial_status_sign_date")
  @@index([renewal_date], map: "IX_contracts_renewal_date")
}

model quotations {
  id                          String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  quotation_number            String    @db.NVarChar(50)
  version_no                  Int       @default(1)
  previous_version_id         String?   @db.UniqueIdentifier
  customer_id                 String    @db.UniqueIdentifier
  application_id              String?   @db.UniqueIdentifier
  project_id                  String?   @db.UniqueIdentifier
  scheme_id                   String?   @db.UniqueIdentifier
  quotation_date              DateTime  @db.Date
  validity_date               DateTime? @db.Date
  currency                    String    @db.NVarChar(3)
  technical_approved_mandays  Decimal?  @db.Decimal(10, 2)
  subtotal_amount             Decimal   @db.Decimal(19, 4)
  discount_amount             Decimal   @default(0) @db.Decimal(19, 4)
  tax_amount                  Decimal   @default(0) @db.Decimal(19, 4)
  total_amount                Decimal   @db.Decimal(19, 4)
  commercial_notes            String?   @db.NVarChar(Max)
  status                      String    @default("DRAFT") @db.NVarChar(30)
  created_by                  String    @db.UniqueIdentifier
  approved_by                 String?   @db.UniqueIdentifier
  approved_at                 DateTime? @db.DateTime2
  sent_at                     DateTime? @db.DateTime2
  accepted_at                 DateTime? @db.DateTime2
  rejected_at                 DateTime? @db.DateTime2
  cancelled_at                DateTime? @db.DateTime2
  created_at                  DateTime  @default(now()) @db.DateTime2
  updated_at                  DateTime  @default(now()) @updatedAt @db.DateTime2

  previous_version quotations?  @relation("QuotationRevisions", fields: [previous_version_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  revisions        quotations[] @relation("QuotationRevisions")
  customer         customers    @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  application      certification_applications? @relation(fields: [application_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project          certification_projects? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scheme           certification_schemes? @relation(fields: [scheme_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  lines            quotation_line_items[]
  linked_contract  contracts?

  @@unique([quotation_number, version_no], map: "UQ_quotations_number_version")
  @@index([customer_id, status, quotation_date], map: "IX_quotations_customer_status_date")
  @@index([project_id, status], map: "IX_quotations_project_status")
  @@index([scheme_id, status], map: "IX_quotations_scheme_status")
  @@index([previous_version_id], map: "IX_quotations_previous_version")
}

model quotation_line_items {
  id             String   @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  quotation_id   String   @db.UniqueIdentifier
  line_no        Int
  description    String   @db.NVarChar(1000)
  quantity       Decimal  @db.Decimal(18, 4)
  unit_price     Decimal  @db.Decimal(19, 4)
  line_total     Decimal  @db.Decimal(19, 4)
  created_at     DateTime @default(now()) @db.DateTime2

  quotation quotations @relation(fields: [quotation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([quotation_id, line_no], map: "UQ_quotation_lines_quotation_line")
  @@index([quotation_id], map: "IX_quotation_lines_quotation")
}

model billing_milestones {
  id                String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  contract_id       String    @db.UniqueIdentifier
  project_id        String?   @db.UniqueIdentifier
  milestone_type    String    @db.NVarChar(50)
  milestone_name    String    @db.NVarChar(255)
  planned_amount    Decimal   @db.Decimal(19, 4)
  currency          String    @db.NVarChar(3)
  planned_date      DateTime? @db.Date
  invoice_reference String?   @db.NVarChar(100)
  invoice_date      DateTime? @db.Date
  paid_amount       Decimal   @default(0) @db.Decimal(19, 4)
  paid_date         DateTime? @db.Date
  status            String    @default("PLANNED") @db.NVarChar(30)
  note              String?   @db.NVarChar(1000)
  created_by        String    @db.UniqueIdentifier
  updated_by        String?   @db.UniqueIdentifier
  created_at        DateTime  @default(now()) @db.DateTime2
  updated_at        DateTime  @default(now()) @updatedAt @db.DateTime2

  contract contracts @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project  certification_projects? @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  history  billing_milestone_actions[]

  @@index([contract_id, status, planned_date], map: "IX_billing_milestones_contract_status_date")
  @@index([project_id, status], map: "IX_billing_milestones_project_status")
  @@index([currency, status], map: "IX_billing_milestones_currency_status")
}

model billing_milestone_actions {
  id                 String   @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  billing_milestone_id String @db.UniqueIdentifier
  action             String   @db.NVarChar(50)
  from_status        String?  @db.NVarChar(30)
  to_status          String   @db.NVarChar(30)
  snapshot_json      String   @db.NVarChar(Max)
  actor_id           String   @db.UniqueIdentifier
  created_at         DateTime @default(now()) @db.DateTime2

  milestone billing_milestones @relation(fields: [billing_milestone_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([billing_milestone_id, created_at], map: "IX_billing_actions_milestone_created")
}

model certification_agreements {
  id               String   @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  customer_id      String   @db.UniqueIdentifier
  contract_id      String?  @db.UniqueIdentifier
  agreement_number String   @unique @db.NVarChar(50)
  sign_date        DateTime @db.Date
  created_at       DateTime @default(now())

  customers              customers                @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  contracts              contracts?               @relation(fields: [contract_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  certification_projects certification_projects[]

  @@index([customer_id])
  @@index([contract_id])
}

model customers {
