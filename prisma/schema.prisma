model expert_competencies {
  id        String @id @default(uuid()) @db.UniqueIdentifier
  expert_id String @db.UniqueIdentifier

  management_system String @db.NVarChar(30)
  standard_code     String @db.NVarChar(100)
  competency_role   String @db.NVarChar(50)

  scope_level   String  @default("IAF") @db.NVarChar(20)
  iaf_code      String  @db.NVarChar(20)
  nace_revision String? @db.NVarChar(30)
  nace_code     String? @db.NVarChar(30)

  competency_level String @default("QUALIFIED") @db.NVarChar(30)
  approval_status  String @default("DRAFT") @db.NVarChar(30)

  effective_date DateTime  @db.Date
  expiry_date    DateTime? @db.Date

  scope_description String? @db.NVarChar(Max)
  restriction       String? @db.NVarChar(Max)
  approval_basis    String? @db.NVarChar(Max)
  evidence_summary  String? @db.NVarChar(Max)
  notes             String? @db.NVarChar(Max)

  approved_by String?   @db.UniqueIdentifier
  approved_at DateTime? @db.DateTime2

  suspended_at      DateTime? @db.DateTime2
  suspension_reason String?   @db.NVarChar(Max)

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  experts experts @relation(fields: [expert_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approved_by_user users? @relation("ExpertCompetencyApprovedBy", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([expert_id, management_system, standard_code, competency_role, iaf_code, nace_code])
  @@index([expert_id])
  @@index([management_system])
  @@index([standard_code])
  @@index([competency_role])
  @@index([iaf_code])
  @@index([nace_code])
  @@index([approval_status])
  @@index([expiry_date])
}

model industry_classifications {
  id                  String  @id @default(uuid()) @db.UniqueIdentifier
  classification_type String  @db.NVarChar(20)
  revision            String  @db.NVarChar(30)
  code                String  @db.NVarChar(30)
  title_en            String  @db.NVarChar(500)
  title_vi            String? @db.NVarChar(500)
  parent_code         String? @db.NVarChar(30)
  level               Int

  valid_from DateTime? @db.Date
  valid_to   DateTime? @db.Date
  is_active  Boolean   @default(true)

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  source_mappings industry_code_mappings[] @relation("IndustryMappingSource")
  target_mappings industry_code_mappings[] @relation("IndustryMappingTarget")

  nace_iaf_mappings nace_iaf_mappings[]

  @@unique([classification_type, revision, code])
  @@index([classification_type])
  @@index([revision])
  @@index([code])
  @@index([parent_code])
  @@index([is_active])
}

model industry_code_mappings {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  source_code_id String @db.UniqueIdentifier
  target_code_id String @db.UniqueIdentifier

  mapping_type   String  @db.NVarChar(30)
  mapping_status String  @default("DRAFT") @db.NVarChar(30)
  note           String? @db.NVarChar(Max)

  valid_from DateTime? @db.Date
  valid_to   DateTime? @db.Date

  approved_by String?   @db.UniqueIdentifier
  approved_at DateTime? @db.DateTime2

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  project_scopes certification_project_scopes[] @relation("ProjectScopeIsicNaceMapping")

  source_code industry_classifications @relation("IndustryMappingSource", fields: [source_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  target_code industry_classifications @relation("IndustryMappingTarget", fields: [target_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approved_by_user users? @relation("IndustryCodeMappingApprovedBy", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([source_code_id, target_code_id])
  @@index([source_code_id])
  @@index([target_code_id])
  @@index([mapping_status])
}

model iaf_scopes {
  id          String  @id @default(uuid()) @db.UniqueIdentifier
  iaf_code    String  @unique @db.NVarChar(20)
  iaf_name    String  @db.NVarChar(500)
  description String? @db.NVarChar(Max)
  is_active   Boolean @default(true)

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  nace_iaf_mappings nace_iaf_mappings[]
  certification_body_capabilities certification_body_capabilities[]

  @@index([is_active])
}

model certification_body_capabilities {
  id             String    @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  program_code   String    @db.NVarChar(100)
  program_name   String    @db.NVarChar(255)
  iaf_scope_id   String    @db.UniqueIdentifier
  status         String    @default("ACTIVE") @db.NVarChar(30)
  effective_from DateTime  @db.Date
  effective_to   DateTime? @db.Date
  notes          String?   @db.NVarChar(Max)
  created_by     String?   @db.UniqueIdentifier
  updated_by     String?   @db.UniqueIdentifier
  created_at     DateTime  @default(now()) @db.DateTime2
  updated_at     DateTime  @default(now()) @updatedAt @db.DateTime2

  iaf_scope iaf_scopes @relation(fields: [iaf_scope_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  creator   users?     @relation("CertificationBodyCapabilityCreatedBy", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updater   users?     @relation("CertificationBodyCapabilityUpdatedBy", fields: [updated_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  review_snapshots application_review_capability_snapshots[]

  @@unique([program_code, iaf_scope_id], map: "UQ_certification_body_capability_program_iaf")
  @@index([status, effective_from, effective_to], map: "IX_certification_body_capability_status_dates")
  @@index([iaf_scope_id], map: "IX_certification_body_capability_iaf")
  @@index([created_by], map: "IX_certification_body_capability_created_by")
  @@index([updated_by], map: "IX_certification_body_capability_updated_by")
}

model nace_iaf_mappings {
  id           String @id @default(uuid()) @db.UniqueIdentifier
  nace_code_id String @db.UniqueIdentifier
  iaf_scope_id String @db.UniqueIdentifier

  management_system String @db.NVarChar(30)
  mapping_status    String @default("DRAFT") @db.NVarChar(30)

  source_document String? @db.NVarChar(500)
  note            String? @db.NVarChar(Max)

  valid_from DateTime? @db.Date
  valid_to   DateTime? @db.Date

  approved_by String?   @db.UniqueIdentifier
  approved_at DateTime? @db.DateTime2

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  nace_code industry_classifications @relation(fields: [nace_code_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  iaf_scope iaf_scopes @relation(fields: [iaf_scope_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approved_by_user users?                         @relation("NaceIafMappingApprovedBy", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project_scopes   certification_project_scopes[] @relation("ProjectScopeNaceIafMapping")

  @@unique([nace_code_id, iaf_scope_id, management_system])
  @@index([nace_code_id])
  @@index([iaf_scope_id])
  @@index([management_system])
  @@index([mapping_status])
}

model certification_project_scopes {
  id         String @id @default(uuid()) @db.UniqueIdentifier
  project_id String @db.UniqueIdentifier

  isic_nace_mapping_id String @db.UniqueIdentifier
  nace_iaf_mapping_id  String @db.UniqueIdentifier

  management_system String @db.NVarChar(30)
  standard_code     String @db.NVarChar(100)
  scope_description String @db.NVarChar(Max)

  status String  @default("DRAFT") @db.NVarChar(30)
  notes  String? @db.NVarChar(Max)

  selected_by String   @db.UniqueIdentifier
  selected_at DateTime @default(now()) @db.DateTime2

  approved_by String?   @db.UniqueIdentifier
  approved_at DateTime? @db.DateTime2

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  project certification_projects @relation(fields: [project_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  isic_nace_mapping industry_code_mappings @relation("ProjectScopeIsicNaceMapping", fields: [isic_nace_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  nace_iaf_mapping nace_iaf_mappings @relation("ProjectScopeNaceIafMapping", fields: [nace_iaf_mapping_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  selected_by_user users @relation("ProjectScopeSelectedBy", fields: [selected_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  approved_by_user         users?                     @relation("ProjectScopeApprovedBy", fields: [approved_by], references: [id], onDelete: NoAction, onUpdate: NoAction)
  audit_team_member_scopes audit_team_member_scopes[]

  @@unique([project_id, isic_nace_mapping_id, nace_iaf_mapping_id])
  @@index([project_id])
  @@index([isic_nace_mapping_id])
  @@index([nace_iaf_mapping_id])
  @@index([management_system])
  @@index([standard_code])
  @@index([status])
  @@index([selected_by])
  @@index([approved_by])
}
