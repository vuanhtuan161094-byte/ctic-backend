  @@index([requested_by, created_at], map: "IX_customer_user_access_request_requested_by")
  @@index([target_user_id, status], map: "IX_customer_user_access_request_target_status")
  @@index([reviewed_by, reviewed_at], map: "IX_customer_user_access_request_reviewed_by")
