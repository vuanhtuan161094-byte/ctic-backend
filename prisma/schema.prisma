  assignment_status String @default("assigned") @db.NVarChar(30)

  competency_status String  @default("not_checked") @db.NVarChar(30)
  competency_note   String? @db.NVarChar(Max)

  confirmed_at DateTime? @db.DateTime2
  created_at   DateTime  @default(now()) @db.DateTime2
  updated_at   DateTime  @default(now()) @updatedAt @db.DateTime2

  audit_team_appointments audit_team_appointments @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  experts experts @relation(fields: [expert_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  scopes          audit_team_member_scopes[]
  program_mandays audit_member_program_mandays[]

  @@unique([appointment_id, expert_id])
  @@index([expert_id])
  @@index([planned_start_date, planned_end_date])
  @@index([assignment_status])
  @@index([team_role])
}

model audit_team_member_scopes {
  id        String @id @default(uuid()) @db.UniqueIdentifier
  member_id String @db.UniqueIdentifier

  iaf_code  String? @db.NVarChar(20)
  nace_code String? @db.NVarChar(30)

  activity_description String?  @db.NVarChar(Max)
  coverage_type        String   @default("full") @db.NVarChar(40)
  planned_mandays      Decimal? @db.Decimal(10, 2)

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  audit_team_members audit_team_members            @relation(fields: [member_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  project_scope_id   String?                       @db.UniqueIdentifier
  project_scope      certification_project_scopes? @relation(fields: [project_scope_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([member_id])
  @@index([iaf_code])
  @@index([nace_code])
  @@index([project_scope_id])
}


model audit_program_manday_requirements {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  appointment_id String @db.UniqueIdentifier

  program_key      String  @db.NVarChar(200)
  management_system String @db.NVarChar(30)
  standard_code     String @db.NVarChar(100)
  pre_ims_mandays   Decimal @default(0) @db.Decimal(10, 2)
  required_units    Int

  created_at DateTime @default(now()) @db.DateTime2
  updated_at DateTime @default(now()) @updatedAt @db.DateTime2

  audit_team_appointments audit_team_appointments @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([appointment_id, program_key], map: "UQ_audit_program_manday_requirement")
  @@index([appointment_id], map: "IX_audit_program_manday_requirement_appointment")
