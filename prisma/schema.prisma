  submitted_at        DateTime  @default(now()) @db.DateTime2
  reviewed_at         DateTime? @db.DateTime2
  applied_at          DateTime? @db.DateTime2
  created_at          DateTime  @default(now()) @db.DateTime2
  updated_at          DateTime  @default(now()) @updatedAt @db.DateTime2

  customer       customers                      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_customer_user_access_request_customer")
