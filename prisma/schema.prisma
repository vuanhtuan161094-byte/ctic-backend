model customer_user_access_history {
  id                      String   @id @default(dbgenerated("newid()")) @db.UniqueIdentifier
  customer_user_access_id String   @db.UniqueIdentifier
  customer_id             String   @db.UniqueIdentifier
  user_id                 String   @db.UniqueIdentifier
  action                  String   @db.NVarChar(30)
  source_type             String   @db.NVarChar(30)
  source_request_id       String?  @db.UniqueIdentifier
  changed_by              String?  @db.UniqueIdentifier
  note                    String?  @db.NVarChar(Max)
  changed_at              DateTime @default(now()) @db.DateTime2

  access         customer_user_access           @relation(fields: [customer_user_access_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_customer_user_access_history_access")
  customer       customers                      @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_customer_user_access_history_customer")
  user           users                          @relation("CustomerUserAccessHistoryUser", fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_customer_user_access_history_user")
  changer        users?                         @relation("CustomerUserAccessHistoryChangedBy", fields: [changed_by], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_customer_user_access_history_changed_by")
  source_request customer_user_access_requests? @relation("CustomerUserAccessHistorySourceRequest", fields: [source_request_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "FK_customer_user_access_history_source_request")

  @@index([customer_id, changed_at], map: "IX_customer_user_access_history_customer_changed")
  @@index([user_id, changed_at], map: "IX_customer_user_access_history_user_changed")
