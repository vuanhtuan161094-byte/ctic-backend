model audit_manday_allocation_versions {
  id             String @id @default(uuid()) @db.UniqueIdentifier
  appointment_id String @db.UniqueIdentifier
  version_no     Int

  calculation_version String @db.NVarChar(50)
  stage1_units        Int
  stage2_units        Int
  allocation_mode     String @db.NVarChar(30)

  before_json  String? @db.NVarChar(Max)
  after_json   String  @db.NVarChar(Max)
  change_reason String? @db.NVarChar(Max)

  created_by String @db.UniqueIdentifier
  created_at DateTime @default(now()) @db.DateTime2

  audit_team_appointments audit_team_appointments @relation(fields: [appointment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  created_by_user         users @relation("AuditMandayAllocationVersionCreatedBy", fields: [created_by], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([appointment_id, version_no], map: "UQ_audit_manday_allocation_version")
  @@index([appointment_id, created_at], map: "IX_audit_manday_allocation_version_appointment")
  @@index([created_by], map: "IX_audit_manday_allocation_version_created_by")
