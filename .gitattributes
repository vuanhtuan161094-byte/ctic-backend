* text=auto

# Source and configuration files use LF in the repository and checkout.
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.prisma text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.xml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.sh text eol=lf
*.example text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.nvmrc text eol=lf
.prettierrc text eol=lf

# Native Windows command and PowerShell scripts use CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must never undergo text or line-ending conversion.
*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.zip binary
*.gz binary
*.7z binary
*.rar binary
*.exe binary
*.dll binary
*.node binary
